generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
  SELLER
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
  LOCKED
}

enum ChallengeKind {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String        @id @default(uuid()) @db.Char(36)
  email           String        @unique @db.VarChar(254)
  passwordHash    String        @db.VarChar(255)
  name            String        @db.VarChar(100)
  phone           String?       @db.VarChar(20)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  role            Role          @default(CUSTOMER)
  status          AccountStatus @default(PENDING_VERIFICATION)
  failedLogins    Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  challenges      Challenge[]
  addresses       Address[]
  mfa             MfaFactor?
  privacyRequests PrivacyRequest[]
  auditEvents     AuditEvent[]
  wholesaleApproved Boolean @default(false)
  wishlist WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews ProductReview[]
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @db.Char(36)
  familyId     String   @db.Char(36)
  tokenHash    String   @unique @db.Char(64)
  mfaVerified  Boolean  @default(false)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model Challenge {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @db.Char(36)
  kind      ChallengeKind
  tokenHash String        @unique @db.Char(64)
  target    String        @db.VarChar(254)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, usedAt])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  label      String   @db.VarChar(50)
  recipient  String   @db.VarChar(100)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String?  @db.VarChar(20)
  country    String   @db.Char(2)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MfaFactor {
  userId          String    @id @db.Char(36)
  encryptedSecret String    @db.VarChar(255)
  confirmedAt     DateTime?
  lastUsedStep    Int        @default(-1)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacyRequest {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  kind      String   @db.VarChar(20)
  status    String   @default("PENDING") @db.VarChar(20)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, status])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  action    String   @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// Serializes catalogue mutations (including hierarchy and import validation).
model CatalogLock {
  id Int @id
}

model CatalogImport {
  idempotencyKey String @id @db.VarChar(100)
  actorId String @db.Char(36)
  digest String @db.Char(64)
  result Json
  createdAt DateTime @default(now())
}

model Category {
  id String @id @default(uuid()) @db.Char(36)
  slug String @unique @db.VarChar(100)
  name String @db.VarChar(100)
  parentId String? @db.Char(36)
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]
  @@index([parentId])
}

model Product {
  id String @id @default(uuid()) @db.Char(36)
  slug String @unique @db.VarChar(100)
  name String @db.VarChar(150)
  description String @db.Text
  categoryId String @db.Char(36)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status String @default("DRAFT") @db.VarChar(16)
  kind String @default("PHYSICAL") @db.VarChar(16)
  currency String @default("NGN") @db.Char(3)
  digitalFormat String? @db.VarChar(50)
  digitalBytes Int?
  digitalAssetKey String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  images ProductImage[]
  wishlist WishlistItem[]
  recentlyViewed RecentlyViewed[]
  reviews ProductReview[]
  @@index([status, currency, createdAt])
  @@index([categoryId, status])
  @@index([name])
}

model ProductImage {
  id String @id @default(uuid()) @db.Char(36)
  productId String @db.Char(36)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String @db.VarChar(1000)
  alt String @db.VarChar(200)
  position Int
  @@unique([productId, position])
}

model ProductVariant {
  id String @id @default(uuid()) @db.Char(36)
  productId String @db.Char(36)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku String @unique @db.VarChar(64)
  size String @default("") @db.VarChar(40)
  colour String @default("") @db.VarChar(40)
  style String @default("") @db.VarChar(40)
  active Boolean @default(true)
  priceMinor Int
  salePriceMinor Int?
  saleStartsAt DateTime?
  saleEndsAt DateTime?
  stock Int @default(0)
  lowStockThreshold Int @default(5)
  stockPolicy String @default("DENY") @db.VarChar(16)
  preorderAvailableAt DateTime?
  tiers PriceTier[]
  adjustments StockAdjustment[]
  @@unique([productId, size, colour, style])
  @@index([productId, active, priceMinor])
  @@index([active, stock])
}

model PriceTier {
  id String @id @default(uuid()) @db.Char(36)
  variantId String @db.Char(36)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQuantity Int
  priceMinor Int
  @@unique([variantId, minQuantity])
}

model StockAdjustment {
  id String @id @default(uuid()) @db.Char(36)
  variantId String @db.Char(36)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actorId String @db.Char(36)
  idempotencyKey String @unique @db.VarChar(100)
  delta Int
  resultingStock Int
  reason String @db.VarChar(200)
  createdAt DateTime @default(now())
  @@index([variantId, createdAt])
}

model WishlistItem {
  userId String @db.Char(36)
  productId String @db.Char(36)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
  @@index([userId, createdAt])
}

model RecentlyViewed {
  userId String @db.Char(36)
  productId String @db.Char(36)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())
  @@id([userId, productId])
  @@index([userId, viewedAt])
}

model ProductReview {
  id String @id @default(uuid()) @db.Char(36)
  userId String @db.Char(36)
  productId String @db.Char(36)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating Int
  body String @db.VarChar(2000)
  status String @default("PENDING") @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model CmsContent {
  id String @id @default(uuid()) @db.Char(36)
  slug String @unique @db.VarChar(100)
  kind String @db.VarChar(16)
  title String @db.VarChar(150)
  body String @db.Text
  imageUrl String? @db.VarChar(1000)
  targetPath String? @db.VarChar(200)
  published Boolean @default(false)
  startsAt DateTime?
  endsAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([kind, published])
}
