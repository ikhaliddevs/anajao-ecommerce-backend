NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL="mysql://anajao_dev:change-me@127.0.0.1:3306/anajao_ecommerce_dev?connection_limit=10"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_SECRET=replace-with-at-least-64-cryptographically-random-characters-before-starting
MFA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_LOGIN_LIMIT=10
EMAIL_PROVIDER=disabled
